{
  "name": "@innosquad/inno-flow",
  "version": "1.0.0",
  "description": "Platform-neutral unidirectional state, effect, and output runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InnoSquadCorp/InnoFlow.git",
    "directory": "typescript/packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src/**/*.ts", "!src/**/*.test.ts", "README.md", "LICENSE"],
