  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepack": "tsc -b"
  },
  "keywords": ["state-management", "unidirectional-data-flow", "typescript"],
  "publishConfig": {
    "access": "public"
  }
}
