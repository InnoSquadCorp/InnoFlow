{
  "name": "@innosquad/inno-flow-react",
  "version": "1.0.0",
  "description": "React hooks and typed provider for InnoFlow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InnoSquadCorp/InnoFlow.git",
    "directory": "typescript/packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src/**/*.ts", "!src/**/*.test.ts", "README.md", "LICENSE"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@innosquad/inno-flow": "^1.0.0",
    "react": ">=18.2.0 <20"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepack": "tsc -b"
  },
  "keywords": ["react", "state-management", "use-sync-external-store"],
  "publishConfig": {
    "access": "public"
  }
}
