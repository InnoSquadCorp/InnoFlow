{
  "name": "inno-flow-typescript-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:packed": "node scripts/test-packed-consumer.mjs",
    "test:packed:selftest": "node scripts/check-packed-consumer-selftest.mjs",
    "test:consumer": "npm run build --workspace=@innosquad/inno-flow-react-consumer",
    "validate:packages": "node ./scripts/validate-packages.mjs",
    "test": "npm run clean && npm run build && npm run test:types && npm run test:unit && npm run test:consumer && npm run validate:packages"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "publint": "0.3.24",
    "playwright": "1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@11.19.0"
}
